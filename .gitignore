node_modules/
# Anchored, so it means Composer's directory at the repository root -- an unanchored
# `vendor/` also matches assets/vendor/, which silently left the vendored PixiJS out of
# the checkout and made the plugin uninstallable without a build step.
/vendor/
.DS_Store
*.log
.phpunit.result.cache

# assets/vendor/ and assets/js/ are deliberately committed: the plugin must be
# installable straight from a checkout, without an npm install.
