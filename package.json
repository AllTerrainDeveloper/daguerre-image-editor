{
	"name": "daguerre",
	"version": "0.1.0",
	"private": true,
	"description": "A non-destructive, GPU-accelerated image editor for the WordPress media library.",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"vendor:pixi": "node bin/vendor-pixi.mjs",
		"build": "npm run vendor:pixi && npm run build:bundle && npm run deploy",
		"build:bundle": "vite build --mode development && vite build --mode production",
		"dev": "vite build --mode development --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php:install": "wp-env run tests-cli --env-cwd=wp-content/plugins/daguerre composer install",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/daguerre vendor/bin/phpunit --configuration tests/phpunit/phpunit.xml.dist",
		"deploy": "node bin/deploy.mjs"
	},
	"devDependencies": {
		"@wordpress/env": "^10.17.0",
		"jsdom": "^25.0.1",
		"pixi.js": "^8.6.6",
		"typescript": "^5.7.2",
		"vite": "^5.4.11",
		"vitest": "^2.1.8"
	}
}
